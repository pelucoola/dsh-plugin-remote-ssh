{
  "name": "dsh-plugin-remote-ssh",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH plugin: control remote hosts over SSH from the agent, with a Settings page that manages saved hosts.",
  "license": "MIT",
  "author": "pelucoola",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ssh",
    "remote",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pelucoola/dsh-plugin-remote-ssh.git"
  },
  "homepage": "https://github.com/pelucoola/dsh-plugin-remote-ssh#readme",
  "bugs": {
    "url": "https://github.com/pelucoola/dsh-plugin-remote-ssh/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "market:index": "node scripts/build-market-index.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.0-rc.5"
  }
}
